# ============================================================
# SlideRule — 环境配置
#   cp .env.example .env   然后填值（.env 已被 .gitignore 排除，永不提交）
#
# 只列一键部署与推演主线真正用到的配置；其余高级开关都有安全默认值，
# 需要时查 docs/ 与代码内注释（历史完整清单见 git 历史中的本文件旧版）。
# 任何真实 key 都不要写进本文件——它是要提交进仓库的模板。
# ============================================================

# ── LLM（核心配置）──────────────────────────────────────────
# 任意 OpenAI 兼容供应商（OpenAI / Azure / DashScope / OpenRouter /
# SiliconFlow / Moonshot / 智谱 …）。不填也能启动，但推演走确定性
# 模板回退，看不到真实 LLM 推演。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5

# 线控与手感（下面是长期实跑验证过的一组；按你的网关实测调整）
LLM_WIRE_API=chat_completions
LLM_STREAM=false
# 推理档位。**这是推理模型上最大的那个速度旋钮**，比换模型、比调 prompt 都管用。
#
# 2026-08-13 实测（deepseek-v4-flash，同一道题各采 4 发，取中位数）：
#     low   思考 token 中位数  12   样本 [10, 12, 17, 11]
#     high  思考 token 中位数 198   样本 [26, 37, 360, 392]
#     不传   思考 token 中位数  66   样本 [48, 49, 83, 116]
#
# 为什么它是速度旋钮：实测这条链的墙钟 ≈ completion_tokens ÷ 100（五次独立
# 测量都落在 ~100 tok/s），而 completion 里 **85~90% 是你看不见的思考**。
# 也就是说耗时几乎完全由"模型想了多少"决定，prompt 大小、缓存命中都是次要项
# （实测缓存全命中的那发反而更慢，因为它那次多想了 4 倍）。
#
# ⚠️ 单发方差极大：同样的输入 completion 能从 1455 跳到 5495。判断哪个档位更快
#    必须多发取中位数，看一发就下结论一定被噪声骗（我们就差点栽在这上面）。
#
# ## 为什么不取 low（2026-08-13 定，撤回同日早些时候的 low）
#
# low 确实快一倍，但快出来的那一半是**从产出里省的**，不是白捡的：
#
#     全局 medium   generate 281.9s ok=1   design 292.1s ok=1
#     全局 low      generate 139.4s ok=1   design  95.3s **ok=0** ← 首页跑挂
#
# 挂的形状是 `5 validation errors ... tag Field required`——思考砍到中位数
# 12 个 token，模型拼不出合法的深层节点树，3 次尝试全一样，机械修复
# （json-repair / rowsRef 修补）都触发了也没救回来。
#
# 当时的处置是"全局留 low、只把结构化生成抬回 medium"。这条按住了已知的那个
# 崩点，但赌的是**别的路都不需要思考**——而这条链上到处是深层 JSON 契约
# （五系统建模、页面绑定、覆盖门取证），下一个崩点只是还没撞上而已，
# 而且崩起来同样是静默的校验失败。省的那点时间不值这个赌。
#
# 所以全局取 medium。要提速优先动别的地方（并发、少发一趟、缓存），
# 不要动这个旋钮——它省的是模型的思考量，也就是产出的正确率。
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=600000
LLM_ROUTER_TIMEOUT_MS=600000
# 免输出截断保护的模型白名单（逗号分隔）
LLM_UNLIMITED_MODELS=gpt-5.5

# 控制面（agent 主循环）单独的模型。**留空就跟 LLM_MODEL 走**；
# 填了就**覆盖** LLM_MODEL（见 sliderule_llm/control_client.py:373，
# 取值顺序 参数 > 这个 > cfg.model）。
#
# ⚠ 2026-09-15 踩过：换网关时只改了 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL，
#   这一项还留着上一家的模型名。`/health` 自报的是 LLM_MODEL，看着完全正常，
#   而每一发控制面请求都是
#       upstream 503 {"code":"model_not_found","message":"No available channel
#                     for model <旧模型> under group default"}
#   整条 agent 链一步都走不动，真机白跑一趟才发现。
#
#   **换模型是两个旋钮，不是一个。** 这一项当时根本不在本文件里，
#   所以准备 env 的人和照着改的人都漏了它——补在这里就是为了别再漏。
#
# ⚠ 2026-09-17 换模型的验收方法（踩了一晚上才总结出来）：
#   **必须拿真机对话验，单发问答一律不算数。** 当天试 rcouyi + gemini-3.5-
#   flash-lite，单发怎么试都过——32 token 玩具请求、带完整 49 件工具表的真形状
#   请求、27k token 大载荷，全绿；一上真机连死四趟 content_filter。
#
#   后来把失败那一发从 checkpoint 里原样揪出来重放才看清：触发条件是
#   **完整系统提示词（3338 字）× 带工具调用往返的对话**，两者缺一都不触发，
#   而系统提示词切成任意一半都不触发——没有哪句话犯规，是规模交互越过了
#   那家的安全阈值。而 content_filter 按设计不许重采，**一发就打死整条运行**
#   （详见 sliderule_llm/control_client.py 里 finish == "content_filter" 处）。
#
#   所以换模型的最低验收是：真机跑一趟工程任务，看它能不能走完
#   「问答 → 计划 → project_create → 改文件 → 构建」这一串。
#
#   同日按这个标准验过的（供下一个换模型的人参考，不是推荐清单）：
#
#     gpt-6-astra（ahapi）        ✅ 真机 616 秒零错，里程碑比 gpt-5.6-luna
#                                   快 1.2~1.9×（批准 131s/247s、建工程
#                                   169s/276s、首次改文件 240s/366s）。
#                                   端到端 24~29 tok/s，首字 3.4~4.2s。
#                                   ⚠ reasoning_effort 在它身上近乎无效：
#                                     不传就按需思考，传了 high 反而不增；
#                                     两道题四档答案一样。留 none 即可。
#     gpt-5.6-luna（ahapi）       ⚠ 同网关但路由到 codex，当天 auth_unavailable
#                                   三次，真机连死两趟。
#     gemini-3.5-flash-lite      ❌ 单发全绿、真机连死四趟 content_filter。
#       （rcouyi）                  详见 sliderule_llm/control_client.py。
#
#   ⚠ 2026-09-17 晚，ahapi 整天 503 `auth_unavailable: no auth available
#     (providers=codex, …)`（10:25 到 18:22 跨 8 小时，四趟真机全挂），
#     于是换到 text168 找替补。桌面体检结果（**都还没过真机那一关**）：
#
#     gemini-3.7-flash           待验 长生成 4/4，中位 187 tok/s / 3060 token、
#       （text168）                 finish=stop；content_filter 体检 0/6 触发
#                                   （真实系统提示 × 真实 PROJECT_ARGUMENTS 工具集）。
#                                   快筛 ping 3.9s / 工具调用 2.9s。
#     gemini-3.6-flash           待验 长生成 4/4，中位 135 tok/s。
#     gemini-2.5-flash           待验 长生成 4/4，中位 190 tok/s（输出短些，1372）。
#     gemini-3.8-flash / 3.1-pro ❌ 503 No available ac…（跟 ahapi 一个毛病）
#
#   ⚠⚠ 这里最反直觉的一条：**同一个模型名换个网关就是另一回事。**
#     gpt-6-astra 在 ahapi 上是 ✅（真机 616 秒零错），在 text168 上
#     **长生成 0/9 全超时**——端到端只有 20 tok/s，900 token 的计划要 44s，
#     而客户端读预算是 45s，算出来就该挂。所以验收记录必须写
#     「模型 @ 网关」这一对，只写模型名会骗到下一个人。
#
#   ⚠ 还有一条：**同一个网关、不同 key、可用模型不一样。** text168 的
#     sk-34f9… 能跑 gpt-6-astra 但列表里没有 gemini；sk-e0d4… 有 8 个 gemini
#     却没有 gpt-6-astra。换 key 之后先 GET /v1/models 看一眼，别猜。
SLIDERULE_CONTROL_MODEL=

# 所有 LLM 调用的输出上限——**全链路就这一个旋钮**，默认 65535（不填即 65535）。
# ⚠ 欧亿 / Gemini 口径：maxOutputTokens 1 含、65536 不含。写 65536 会 HTTP 400。
#
# ⚠️ 推理模型（DeepSeek v4 / o 系 / gpt-5 thinking 等）的思考 token 和正文
#    **共用同一个 max_tokens**。预算不够时的表现是**静默返回空正文**：
#    finish_reason=length、completion_tokens 顶满、`empty content from LLM (stream)`。
#    推演停在 orchestrating、日志刷这句，看着像网关坏了，其实是预算不够。
#
# 这里以前是两个分路开关（LLM_GENERATE_MAX_TOKENS / LLM_ROUND_CAP_MAX_TOKENS），
# 已经删掉了，写在 .env 里也不会再被读。删的原因：分路旋钮救不了这个病——
# 换 DeepSeek 那趟这两个都调大了，挂掉的是它俩都管不着的第三处写死预算
# （freeform_block 的 14000，思考吃光，首页设计整段失败，白烧 433.8 秒）。
# 而且留着分路值会反向咬人：一个 LLM_ROUND_CAP_MAX_TOKENS=32000 会让那条路
# 悄悄比全局窄，正是要根除的形态。
#
# 调大是安全的：max_tokens 是**上限不是配额**，按实际生成的 token 计费，
# 模型说完就停。抬高上限不会让正常调用变贵，只是不再被人为截断。
#
# 2026-09-19 默认不设限：不写或写 unlimited / 0，请求里不带 max_tokens。
# 要闸再写正数。65536 仍会被钳成 65535（Gemini 开区间，写大了会 400）。
# LLM_MAX_TOKENS=unlimited

# 你的路由没有 /embeddings 端点时保持 false（避免无谓的 404 请求）；
# 有 embedding 模型可改 true 启用语义向量检索
RAG_VECTOR_ENABLED=false

# 新颖意图由 LLM 生成五系统元模型（经结构门校验，fail-closed）
SLIDERULE_LLM_GENERATE_ENABLED=1

# 能力池并行（默认开：整组 LLM 并发，再按选材顺序 commit）。
# 崩溃恢复要「A/B 跑完再挂、恢复不重烧已完成能力的 LLM」必须串行：
# SLIDERULE_PARALLEL_CAPS=false
# 默认 ON 时 gather 中途崩会整组重烧；commit 之间崩只跳过已落 pending 的。

# 体验区块目录窄化：按题意从 358 个区块里检索一小批注入 prompt，而不是全量倒进去。
# **默认开**（2026-08-11 依据 docs/block-narrowing-eval.md 翻的）。
#
# 依据：两个覆盖域各臂 n=6 对照，对题区块被选中数 0.67 → 3.25（p=0.00004），
# prompt 从 16 万字符降到 5.3 万（−67%）。过闸率无差异——那部分提升来自确定性
# 修复，不是窄化。目录没覆盖该领域时会自动退回全量（检索置信度低于阈值即兜底），
# 所以不会重现"零覆盖域反而更差"那笔代价。
#
# 排查或复跑对照时显式关掉：
# SLIDERULE_BLOCK_CATALOG_NARROWING=0
# 注入上限（默认 60）与置信度阈值（默认 0.20）也可覆盖：
# SLIDERULE_BLOCK_CATALOG_NARROWING_LIMIT=60
# SLIDERULE_BLOCK_CATALOG_NARROWING_MIN_CONFIDENCE=0.20

# spec-first 七步链路（spec → 逐页 HTML → 反推数据模型 → 权限/工作流 →
# 汇合 → 打 data-* 孔）。**2026-08-14 起默认开，不用配置。**
#
# 它取代的是"从一句话同时发明实体/字段/页面/权限/工作流"那条老路。翻默认
# 的证据只有 n=3 的一轮 A/B（过闸 3/3 vs 2/3、页数恒 5 vs 4~6、字段利用率
# 95% vs 71%）——比目录窄化那次（p=0.00004）薄得多，所以退路必须留着。
#
# 一轮 8~9 分钟、烧十几次 LLM。要跑对照或怀疑它出问题时关回老路：
# SLIDERULE_SPEC_FIRST=0
#
# ⚠ 整条链挂了会**显式回落老路并打日志**（不静默）。日志里搜
#   "spec-first 失败，回落老链路" 就知道这一轮走的是哪条。

# 演示域夹具快路径（采购/请假/工单/入职四个内置域）。**默认关，别在生产开。**
#
# 开着的话，这四个域的题会跳过整条 LLM 生成，直接端出 2026-07 之前冻结的
# 那份样板。2026-08-10 实测：一道真实的「客服工单系统」因此被认成
# service_ticket 并放行（题和夹具确实同域，相关性尺子挑不出错），
# model.generate 0 次，交付的 5 个页面里连 blocks 这个键都不存在——
# 359 个区块一个都没用上。
#
# 只在需要"零 LLM、可复现"的演示或回归时开：
#   SLIDERULE_DEMO_FIXTURE_ENABLED=1
# SLIDERULE_DEMO_FIXTURE_ENABLED=0

# 通道支持图片输入（多模态 content parts）时置 1：图片附件走视觉 LLM
# 提取内容注入推演。不支持的通道保持 0——附件解析会如实降级为只带文件名
#
# ⚠️ 纯文本模型（如 DeepSeek v4）必须置 0。置 1 的话「照参照图取色」那条链路会
#    **先花 ~70s 生成参照图、再拿去撞 400、重试 3 次**——纯烧时间且必然失败
#    （报错 `unknown variant \`image_url\`, expected \`text\``）。
LLM_SUPPORTS_IMAGE_CONTENT_PARTS=1

# ── 账号体系（2026-08-03）────────────────────────────────────
# 生产环境**必须**设置，否则 Python 服务拒绝启动（这类配置没有安全的兜底值）。
#   openssl rand -hex 32
# SLIDERULE_AUTH_SECRET=

# ── 验证码邮件投递 ──────────────────────────────────────────
#
# 三种模式：console / smtp / resend。不配 = console（只打印，验证码直接回在
# 注册响应里），自部署零配置也能跑通。
#
# ⚠️ console 模式**不能对外开放**：验证码回在注册接口的响应里，等于谁都能
#    注册任意邮箱。上线前必须换成 smtp 或 resend。
#
# 配好之后自检（比"注册一次看有没有收到"快得多）：
#   docker exec sliderule-python python scripts/mail_check.py --to 你的邮箱
#
#
# ═══ 第一步：你有没有域名 ═══════════════════════════════════
#
# **所有专业发信服务都要求验证发信域名**（Resend / 阿里云邮件推送 / 腾讯云 SES
# / SendGrid 全都一样）——这是反垃圾邮件的行业底线，绕不过去。
#
# ▸ 有域名 → 往下看「方案 A」。
#   注意：**域名不需要指向这台服务器**。邮箱域名验证只看 DNS 的 TXT/MX 记录，
#   跟 A 记录指向哪里完全无关。域名挂在别处照样能验证。
#
# ▸ 没域名 → 看「方案 B」（用个人邮箱的 SMTP 授权码），或者花几十块买一个。
#
#
# ═══ 方案 A：有域名，走 Resend（或任意服务商）═══════════════
#
# ⚠️ 要留意的是**记录加在哪一层**，而不是"域名填什么"。
#
# 根域名上通常已经有 MX 和 SPF（企业邮箱、域名商的邮件转发都会加）。发信服务
# 如果也把 MX/SPF 加在根域名上，会出两件事，而且**都是静默的**：
#   · 它的 MX（收退信用）→ **顶掉现有的邮件转发**，发到 @你的域名 的信收不到
#   · **一个域名只能有一条 SPF**，加第二条会让两条都失效
#
# Resend 已经替你避开了：它把 MX/SPF 放在 send. 子域下（见下面步骤 2），
# 根域名只加一条 DKIM 的 TXT，不冲突。换别家服务商时要自己确认这一点。
#
# 步骤（2026-08-03 对 miantuan.ai 实跑验证过）：
#   1. Resend → Domains → Add Domain → **填根域名**（比如 miantuan.ai）
#   2. 它给三条记录，注意 Host 列：
#        TXT  resend._domainkey   ← DKIM，在根域名下
#        TXT  send                ← SPF，**Resend 自动放在 send 子域**
#        MX   send                ← 退信反馈，同上
#      也就是说**你不用手动指定子域**，Resend 已经替你把 MX/SPF 放到 send. 下，
#      根域名原有的 MX/SPF 不受影响。上面那段冲突警告它自己就避开了。
#   3. 去域名商的 DNS 管理里照抄（Namecheap 在 Advanced DNS；Host 字段就填
#      Resend 给的那个值，不要带 .你的域名，Namecheap 会自动补）
#      ⚠️ Namecheap 的 MX 不在 HOST RECORDS 区，在下面的 MAIL SETTINGS 区，
#         且要先把模式从 Email Forwarding 切成 Custom MX 才能加自定义 MX。
#         切换会清掉域名商自动管的转发 MX/SPF——先去 Domain 页确认
#         REDIRECT EMAIL 是空的（没在用转发）再切。
#   4. 回 Resend 点 Verify（**不会自动检测，必须手动点**）
#   5. 配下面三行
#
# ⚠️ 发信地址用**根域名**，不是 send. 子域：
#    send.你的域名 只是 Resend 放 SPF/退信的技术子域（Return-Path），
#    它本身不是你账号里的域名，拿它当发信地址会被 403 拒掉
#    （"The send.xxx domain is not verified"）。
#
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=
# SMTP_FROM=SlideRule <no-reply@你的域名>
#
# 域名验证**之前**只能用 Resend 的沙盒地址 onboarding@resend.dev，而它
# **只能发给你自己的 Resend 注册邮箱**——别人注册会被 422 拒掉。也就是说
# 不验证域名，真实用户根本注册不了。
#
#
# ═══ 方案 B：没有域名，用个人邮箱的 SMTP 授权码 ═════════════
#
# QQ/163 邮箱提供个人 SMTP，用你自己的邮箱当发信人，**不需要域名**。
# 授权码：QQ 邮箱 → 设置 → 账户 → POP3/IMAP/SMTP 服务 → 开启 SMTP →
# 按提示发短信 → 得到 16 位的码。**那个码是 SMTP_PASSWORD，不是 QQ 密码。**
#
# EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=smtp.qq.com                 # 163 是 smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASSWORD=16位授权码
# SMTP_FROM=SlideRule <你的QQ号@qq.com>
#
# 代价：发信人显示成个人邮箱（不专业）、**有每日发送量上限**（用户量起来会
# 撞墙）、发给 Gmail/163 可能进垃圾箱。适合早期验证，不适合长期。
#
#
# ═══ 其它服务商（都是 SMTP，换四个值即可）══════════════════
#
# 收件人主要在国内时，国内服务商的进箱率明显更好（跟配没配 SPF 无关，
# 是国际发信服务商发往国内邮箱的固有劣势）。
#
# SMTP_HOST=smtpdm.aliyun.com           # 阿里云邮件推送
# SMTP_HOST=smtp.qcloudmail.com         # 腾讯云 SES
# SMTP_HOST=smtp.resend.com             # Resend 也提供 SMTP（用户名固定 resend，
#                                       #   密码填 API Key）
#
# ⚠️ 端口默认 465（隐式 SSL）而不是 587：**国内云服务器默认封 25 端口**
#    （阿里云 ECS 明确禁用，腾讯云同理）。465 是各家国内服务商的推荐口。
#    服务器不支持 STARTTLS 时代码会**拒绝发送**而不是降级明文——验证码是凭据。
#
# ⚠️ 走 HTTP API（EMAIL_DELIVERY_MODE=resend）只需要 443。SMTP 端口被网络
#    策略封掉时用这条——这个项目已经踩过同型的坑：数据库的 TCP 5432 不通，
#    最后靠 HTTPS SQL 网关才连上（见下面 APP_STORE_HTTP_API_URL）。

# ── 可选：evidence.search 全网检索 ──────────────────────────
# SerpAPI 兼容端点的 key；不填走 DuckDuckGo 回退，再不行如实降级
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_API_URL=https://serpapi.com/search.json

# ── 可选：E2B 沙盒（code.run 执行工具 + 应用中心真实缩略图截图）────
# 填了 key 工具即可用；不填 fail-closed（工具自动不可用，不假装）。
# key 从 https://e2b.dev → Dashboard → API Keys 获取。
# E2B_API_KEY=
# Internal administrator engineering mode only; still ignored in production.
# SLIDERULE_PROJECT_RUNTIME_INTERNAL_ENABLED=0
# Explicit rollout: disabled | internal (dev administrator) | allowlist.
# Allowlist requires durable Postgres, isolated HTTPS/WSS, browser template and E2B.
# Run pnpm run project:preflight; configuration checks do not replace a live smoke.
#
# ⚠ 2026-09-17 踩过：**生产上必须用 allowlist，internal 会被静默禁掉。**
#   上面那句 "still ignored in production" 写了，但没写后果——它不报错、不告警，
#   而是让 project_access_enabled() 返回 False，整条工程链**静悄悄回落到旧的
#   HTML 推演**。真机上的表现是：
#
#       runtimeKind  html-prototype   （不是 project）
#       projectId    None
#       工具调用     1 个，然后界面是"页面 / 代码 / 尚未接数据"那套旧壳
#
#   而 docker-compose.project.yml 给 python 服务设的正是 NODE_ENV: production，
#   于是 services/project_rollout.py:45 的
#       if mode == "internal" and production: blockers.append(...)
#   必然命中。把本机开发用的 .env 直接搬上服务器就会这样——当天就是这么发生的。
#
#   生产要开工程模式，这两行一起给（用户 id 不是邮箱，是身份库里的 id）：
#       WHYBUDDY_PROJECT_ROLLOUT=allowlist
#       WHYBUDDY_PROJECT_ALLOWED_USERS=<userId>[,<userId>...]
#   allowlist 还要另外七项（持久库、预览来源、工作台来源、两者隔离、
#   网关 key ≥32、E2B、浏览器模板），缺哪项 rollout_readiness().blockers 会点名。
# WHYBUDDY_PROJECT_ROLLOUT=disabled
# WHYBUDDY_PROJECT_ALLOWED_USERS=
# Keep the worker alive during rollback to stop/reconcile existing sandboxes.
# WHYBUDDY_PROJECT_CLEANUP_ENABLED=1
# Exact workbench origin used by the authenticated source-selection bridge.
# WHYBUDDY_PROJECT_WORKBENCH_ORIGIN=https://workbench.example.com
# Durable runtime worker limits. Explicit /touch activity extends idle time;
# reading snapshots/logs never extends the total lifetime budget.
# SLIDERULE_PROJECT_MAX_WORKERS=2
# SLIDERULE_PROJECT_POLL_SECONDS=2
# SLIDERULE_PROJECT_LEASE_SECONDS=120
# SLIDERULE_PROJECT_LIFETIME_SECONDS=900
# SLIDERULE_PROJECT_IDLE_SECONDS=300
# SLIDERULE_PROJECT_INSTALL_SECONDS=600
# SLIDERULE_PROJECT_READY_SECONDS=60
# Optional isolated preview. Run pnpm run build:project-preview before Python.
# Each runtime needs its own HTTPS host; the app sandbox must reach it via WSS.
# Gateway and Python share this separate random key (32+ printable characters).
# The application receives only a scoped tunnel credential, never this key.
# Python authority and Vite dev/build must receive the same PUBLIC template.
# Vite uses it for frame-src; rebuilding is required after changing a deployed preview domain.
# Use a dedicated preview domain. The gateway key below stays server-side.
# WHYBUDDY_PROJECT_PREVIEW_ORIGIN_TEMPLATE=https://{runtimeId}.preview.example.com
# WHYBUDDY_PROJECT_PREVIEW_GATEWAY_KEY=
# Gateway calls back into Python to authorize each ticket. The gateway refuses
# plain http: unless the host is loopback, so a compose deployment must point
# this at the workbench HTTPS origin rather than at the internal service name.
# WHYBUDDY_PROJECT_PREVIEW_AUTHORITY_URL=https://workbench.example.com/api/sliderule/internal/project-preview
# WHYBUDDY_PROJECT_PREVIEW_AGENT_BUNDLE=dist/project-preview/agent.cjs
# Gateway runs separately with .env.preview (see .env.preview.example).
# Reading a preview never starts/resumes a sandbox or extends its lifetime.
# Fixed template browser checks use a SEPARATE trusted E2B browser image with
# @playwright/test 1.61.1 and its Chromium installed. Empty => blocked, no cloud IO.
# The tasks profile checks real SQLite/API/roles. Counter checks cover the demo only.
# WHYBUDDY_PROJECT_BROWSER_TEMPLATE=
# WHYBUDDY_PROJECT_BROWSER_TIMEOUT_SECONDS=120
# 应用中心真实截图额外需要这个：本应用自身的公网可达地址（E2B 沙盒是独立
# 云端机器，够不到宿主 localhost）。留空则截图功能不可用，前端如实回退占位
# 卡，不会报错也不会假装成功。
# SLIDERULE_PUBLIC_APP_URL=https://your-deployed-domain.example.com
# 截图沙盒的自定义 E2B 模板名（可选，强烈推荐）：用 e2b CLI 把
# playwright+chromium 预先烤进模板后填这里，截图沙盒秒级启动；不填则每个
# 一次性沙盒现装（实测 29.1s/次）。做法同 AGENTSHIRE_E2B_TEMPLATE 先例。
# SLIDERULE_E2B_TEMPLATE=
# 说明：应用中心卡片的缩略图**不走这条路**。卡片有三级来源，靠前的更可信：
#   ① 真截图 —— 前端在活渲染那张卡上就地采集后回传（零配置、零基础设施，
#                见 client/src/lib/thumb-capture.ts）
#   ② 参照板 —— 生成时给设计 LLM 排版式用的示意图，落库即有
#   ③ 活渲染 —— 前两级都没有时的兜底
# 上面这两个 E2B 变量只服务于 /sessions/{id}/screenshot 这个按需截图接口，
# 与卡片缩略图无关。

# ── 可选：库存图检索（画页落地后按 img alt 换 Unsplash 直链）──
# 不配也能跑：退到一份 HEAD 校验过的 images.unsplash.com 目录（整词命中
# 才换，对不上留 placehold.co）。配了走官方 Search，图更贴题、一页不重复。
# 免费申请：https://unsplash.com/developers  → Access Key
# UNSPLASH_ACCESS_KEY=

# ── 可选：生图（只用于首页版式参照板）─────────────────────────
# 任意 OpenAI 兼容的 images 端点。三项必须齐全，缺一项生图整体不可用。
#
# **配了 = 每个应用生一张首页参照板；不配 = 一张都不生。没有第二个开关。**
# 不配也不会报错：首页退化为纯文字设计（fail-open，绝不拦闭环），代价是
# 版式的丰富度下降、应用中心的卡片回落到活渲染。
#
# 2026-08-03 起只有首页这一张。此前还会为身份主题单独生一张（~74s）只为
# 从图里抠一个种子色出来，那张图从不展示给任何人——已移除，主题改走纯文字选色。
# 注意 IMAGE_API_URL 要填【完整端点】而不是 base，客户端直接 POST 这个
# 地址、不会自己拼 /images/generations 路径。
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=
# 单次生图超时（秒），默认 600。生图普遍慢，实测一张 30~60s 很常见。
# IMAGE_TIMEOUT_S=600

# ── 可选：首页参照板单独走另一家服务商 ─────────────────────────
# 只影响 enrich_monitor_page_overviews 那张首页参照板，其余生图不变。
# 三项配齐才启用，缺任意一项自动回落上面那份，行为与不配时逐字节一致。
#
# 为什么会有这个口子：实测过不同服务商的像素档位差很多（量到过一家出
# 3584x2048≈7.3MP，而当前这家同一 prompt 传 3840x2160 也只回 1672x941≈1.6MP，
# 耗时 85s vs 90s 几乎无差）。参照图的清晰度直接决定设计 LLM 能学到多少版式
# 细节，而首页那张是目前唯一驱动版式的图（FreeformInsight 未放开，单区块参照
# 图只在首页那张失败时兜底），所以口子开在这一处收益最大、改动面最小。
# SHEET_IMAGE_API_URL=
# SHEET_IMAGE_MODEL=
# SHEET_IMAGE_API_KEY=
# 尺寸/请求体形态：不同服务商字段名不一样，传错不报错、只会拿到默认档位的图。
#   size 形态（OpenAI 标准）  ：SHEET_IMAGE_BODY_STYLE=size,       SHEET_IMAGE_SIZE=1792x1024
#   image_size 形态（另一类）：SHEET_IMAGE_BODY_STYLE=image_size, SHEET_IMAGE_SIZE=2K
# SHEET_IMAGE_BODY_STYLE=size
# SHEET_IMAGE_SIZE=
# SHEET_IMAGE_ASPECT_RATIO=16:9
# SHEET_IMAGE_TIMEOUT_S=600

# 体验层成本预算（可选）：FreeformInsight **区块级**增强最多生成几张视觉参考图 /
# 跑几次截图自检。超预算的区块退化为纯文字生成（有日志，不静默）。默认 4 / 2。
# ⚠️ 这两个**不再管首页参照板**（2026-08-03）：首页那张只认"配没配生图 key"，
#    见上面的生图小节。区块级增强目前处于灰度关闭状态，这两个值实际用不上。
# SLIDERULE_ENRICH_MAX_REF_IMAGES=4
# SLIDERULE_ENRICH_MAX_SCREENSHOT_VERIFY=2

# ── 可选：生产部署的镜像源（仅 docker-compose.prod.yml 用到）──
# 默认 ghcr.io/xiaojilele-glitch/whybuddy-{app,python}:latest，四段都能单独换。
# 详见 docker-compose.prod.yml 头部注释。
#
# 用自己 fork 构建的镜像：
# SLIDERULE_IMAGE_OWNER=<你的GitHub用户名小写>
#
# 国内拉 ghcr 慢：换镜像站（owner 不用动，镜像站透传）
# SLIDERULE_REGISTRY=ghcr.nju.edu.cn
#
# 或走 Docker Hub（⚠️ registry 和 owner 要一起换，Hub 上没有 xiaojilele-glitch
# 这个命名空间；owner 填你的 Docker Hub 用户名，跟 GitHub 的不一定一样）：
# SLIDERULE_REGISTRY=docker.io
# SLIDERULE_IMAGE_OWNER=<你的DockerHub用户名>
#
# 回滚到某次发版（一处改，app/python 一起走）：
# SLIDERULE_IMAGE_TAG=<commit-sha>
#
# 上面三段都拼不出来时，整条地址兜底：
# SLIDERULE_IMAGE_APP=docker.io/<用户名>/whybuddy-app:latest
# SLIDERULE_IMAGE_PYTHON=docker.io/<用户名>/whybuddy-python:latest

# ── 可选：MySQL（只剩 /projects 那套项目空间在用）──────────────
# ⚠️ **登录/注册不需要它**。旧的 Node/MySQL 账号体系已于 2026-08-03 整套删除，
#    账号现在存在应用库那套 Postgres 的 `sliderule_user` 表里
#    （见上面的 SLIDERULE_AUTH_SECRET 与下面的 APP_STORE_DATABASE_URL）。
# 只有 /projects、/tasks、/admin 那几个页面还落 MySQL；不用它们就整段不用配。
#   docker compose --profile accounts up -d
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=sliderule
# DB_USER=root
# DB_PASSWORD=change_me

# ── 可选：生成应用存储 / App Store（推演出来的应用持久化 → 组建库地基）──
# 填了连接串就把每个生成的应用（设计层：五系统模型+appbundle+主题+freeform）
# 存进 Postgres，能查询/索引/并发、能列出历史应用/重开/fork/看改版史；
# 不填就 fail-open 回退本地 JSON 文件（data/sliderule-generated-apps.json），
# 行为跟"没有 DB"完全一致。抽象层只认连接串：自建 PG / RDS / Supabase 都行。
#
# ═══ 通道 A：TCP 直连（部署侧的默认走法，功能最全）═══════════
#
# 当前生产是自建 PostgreSQL 17，与应用同在一个 Docker 网络，不经过任何网关：
# APP_STORE_DATABASE_URL=postgresql://db_api_user:PASSWORD@local-postgres:5432/appdb?sslmode=require
# 用 db_api_user 而不是管理员角色：管理员能建库删库，应用一辈子用不到。
#
# 也接受本地 SQLite（比 JSON 文件强、无需托管服务）：
# APP_STORE_DATABASE_URL=sqlite:///data/apps.db
#
# ═══ 通道 B：HTTPS SQL 网关（受限网络专用）═══════════════════
#
# 只能出 443、连不上 5432 的环境（外部沙盒、无服务器/边缘运行时）走这条。
# 服务端就是本仓库的 deploy/postgres-https-api，Caddy 反代在 /db-api。
# APP_STORE_HTTP_API_URL=https://your-domain.example.com/db-api
# APP_STORE_HTTP_API_KEY=<token>
#
# 三个存储（应用库 / 身份库 / 会话档）都走这一条，落在同一个远端库、不分叉。
# 2026-08-05 之前只有应用库接了网关，另外两个会**静默**回落本地 SQLite——
# 表现是"账号能注册，换台机器就没了"，不报错，所以特地在这里写一句。
#
# ═══ 降级优先级（四级 fail-open）══════════════════════════
#
#   HTTPS SQL 网关 → 远端 TCP → 本地 SQLite → 本地 JSON 文件
#   （通道 B）      （通道 A）
#
# 配了通道 B 就优先用它（受限网络里 TCP 那一整段探测纯属白等）；它不可用时
# 照旧往下走。远端整个不可用才落本地 SQLite，本地库也建不起来才回 JSON。
#
# 注：代码里还有一级"托管库自带的 SQL over HTTP 端点"，夹在 TCP 和本地
# SQLite 之间。它按主机名识别托管服务商，自建 PG 不匹配、自动跳过。
#
# ⚠️ 从本地 SQLite 那一级开始数据与远端分叉：远端恢复后本地这段时间的记录不会
# 自动回流，需要人工导出/合并。降级时日志会打印"现在写在哪"，不静默。

# 本地 SQLite 档的路径（默认如下）。置空则跳过这一级、直接用 JSON——
# 只读文件系统或不想在磁盘上留库文件时用得上：
# APP_STORE_LOCAL_SQLITE=sqlite:///data/sliderule-apps.db

# ── 技能包对象存储（完整 zip，不是 localStorage 卡片）──────────
# 生产（与 python 同 compose）：S3_ENDPOINT=http://minio:9000
# 本地单测 / 没起 MinIO：S3_ENDPOINT=fs（落到 slide-rule-python/data/skills-oss/）
# 密钥只写服务器 .env，不要提交。
# S3_ENDPOINT=fs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=sliderule-skills
