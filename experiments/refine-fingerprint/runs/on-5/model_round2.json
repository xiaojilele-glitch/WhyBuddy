{
 "datamodel": {
  "entities": [
   {
    "id": "elderly",
    "name": "老人档案",
    "fields": [
     {
      "id": "name",
      "name": "老人姓名",
      "type": "string"
     },
     {
      "id": "id_card",
      "name": "身份证号",
      "type": "string"
     },
     {
      "id": "gender",
      "name": "性别",
      "type": "string"
     },
     {
      "id": "birth_date",
      "name": "出生日期",
      "type": "string"
     },
     {
      "id": "address",
      "name": "详细居住地址",
      "type": "string"
     },
     {
      "id": "care_level",
      "name": "护理等级",
      "type": "enum"
     },
     {
      "id": "emergency_contact",
      "name": "紧急联系人",
      "type": "string"
     }
    ]
   },
   {
    "id": "work_order",
    "name": "工单",
    "fields": [
     {
      "id": "order_no",
      "name": "工单编号",
      "type": "string"
     },
     {
      "id": "elderly_ref",
      "name": "老人",
      "type": "ref",
      "refEntity": "elderly"
     },
     {
      "id": "service_log",
      "name": "服务日志与身体状况记录",
      "type": "text"
     }
    ]
   }
  ]
 },
 "rbac": {
  "roles": [
   {
    "id": "r1",
    "name": "社区养老顾问"
   },
   {
    "id": "r2",
    "name": "上门服务人员"
   }
  ],
  "permissions": [
   "elderly:create",
   "elderly:read",
   "elderly:update",
   "elderly:delete",
   "work_order:create",
   "work_order:read",
   "work_order:update",
   "work_order:assign"
  ],
  "menus": [
   {
    "id": "menu_1",
    "label": "老人档案",
    "roleRefs": [
     "r1"
    ],
    "permissionRefs": [
     "elderly:read"
    ]
   },
   {
    "id": "menu_2",
    "label": "应急指挥",
    "roleRefs": [
     "r2"
    ],
    "permissionRefs": [
     "work_order:read"
    ]
   }
  ]
 },
 "workflow": {
  "id": "main_flow",
  "name": "主流程",
  "nodes": [
   {
    "id": "node_created",
    "name": "待派单",
    "assigneeRole": "r1",
    "phase": "initial"
   },
   {
    "id": "node_dispatched",
    "name": "服务中",
    "assigneeRole": "r2",
    "phase": "processing"
   },
   {
    "id": "node_completed",
    "name": "已完成",
    "assigneeRole": "r2",
    "phase": "completed"
   }
  ],
  "transitions": [
   {
    "from": "node_created",
    "to": "node_dispatched",
    "condition": "社区养老顾问发起派单"
   },
   {
    "from": "node_dispatched",
    "to": "node_completed",
    "condition": "上门服务人员完成服务记录"
   }
  ]
 },
 "page": {
  "pages": [
   {
    "id": "p1",
    "name": "老人档案管理页",
    "kind": "workbench",
    "fieldBindings": [
     "elderly.name",
     "elderly.id_card",
     "elderly.gender",
     "elderly.birth_date",
     "elderly.address",
     "elderly.care_level",
     "elderly.emergency_contact"
    ],
    "actionPermissions": [
     "elderly:create",
     "elderly:read",
     "elderly:update",
     "elderly:delete"
    ]
   },
   {
    "id": "p2",
    "name": "应急指挥大屏与工单派发页",
    "kind": "monitor",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.elderly_ref",
     "work_order.service_log"
    ],
    "actionPermissions": [
     "work_order:create",
     "work_order:read",
     "work_order:update",
     "work_order:assign"
    ]
   },
   {
    "id": "p3",
    "name": "移动端服务执行页",
    "kind": "workbench",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.service_log"
    ],
    "actionPermissions": [
     "work_order:read",
     "work_order:update"
    ]
   }
  ]
 },
 "aigc": {
  "capabilities": [
   {
    "id": "ai_1",
    "name": "智能工单分析",
    "inputFields": [
     "work_order.service_log"
    ],
    "outputField": "work_order.order_no",
    "roleRefs": [
     "r1",
     "r2"
    ]
   }
  ]
 },
 "appbundle": {
  "pageBindings": [
   {
    "pageRef": "p2",
    "workflowRef": "main_flow"
   },
   {
    "pageRef": "p3",
    "workflowRef": "node_dispatched"
   }
  ],
  "landingPageRef": "p1",
  "preferredDevice": "desktop",
  "roleRefs": [
   "r1",
   "r2"
  ],
  "dataModelRefs": [
   "elderly",
   "work_order"
  ],
  "appIdentity": {
   "appName": "安居颐养"
  },
  "invariants": [
   {
    "id": "inv_elderly_ref",
    "statement": "工单必须关联有效的老人档案",
    "systems": [
     "datamodel"
    ],
    "refs": [
     "work_order",
     "work_order.elderly_ref",
     "elderly"
    ]
   },
   {
    "id": "inv_service_log",
    "statement": "只有在服务中状态下上门服务人员才能填写服务日志",
    "systems": [
     "workflow",
     "datamodel"
    ],
    "refs": [
     "node_dispatched",
     "r2",
     "work_order.service_log"
    ]
   }
  ],
  "deviceAuthority": "single-v1"
 }
}