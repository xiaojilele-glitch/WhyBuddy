    ],
    "outputField": "work_order.urgency",
    "roleRefs": [
     "role_manager",
     "role_consultant"
    ]
   }
  ]
 },
 "appbundle": {
  "pageBindings": [
   {
    "pageRef": "work_order_board_p2",
    "workflowRef": "main_flow"
   }
  ],
  "landingPageRef": "work_order_board_p1",
  "preferredDevice": "desktop",
  "roleRefs": [
   "role_consultant",
   "role_provider",
   "role_manager"
  ],
  "dataModelRefs": [
   "elder",
   "work_order",
   "financial_settlement"
  ],
  "appIdentity": {
   "appName": "安养通"
  },
  "invariants": [
