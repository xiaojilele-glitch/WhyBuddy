     "work_order:update",
     "work_order:assign",
     "work_order:approve",
     "work_order:reject"
    ]
   },
   {
    "id": "p4_dashboard",
    "name": "运营数据大屏与报表",
    "kind": "dashboard",
    "fieldBindings": [
     "community_branch.branch_name",
     "community_branch.elder_count",
     "community_branch.service_total_count",
     "community_branch.completion_rate",
     "community_branch.staff_count",
     "community_branch.satisfaction_score"
    ],
    "actionPermissions": [
     "community_branch:read",
     "community_branch:export"
    ]
   }
  ]
 },
