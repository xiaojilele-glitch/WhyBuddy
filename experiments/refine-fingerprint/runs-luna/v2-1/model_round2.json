 "workflow": {
  "id": "main_flow",
  "name": "主流程",
  "nodes": [
   {
    "id": "wf_intake",
    "name": "统一入口待受理",
    "assigneeRole": "role_service_coordinator",
    "phase": "受理"
   },
   {
    "id": "wf_request_processing",
    "name": "服务需求处理中",
    "assigneeRole": "role_service_coordinator",
    "phase": "需求处理"
   },
   {
    "id": "wf_dispatching",
    "name": "任务调度中",
    "assigneeRole": "role_service_coordinator",
    "phase": "调度"
   },
   {
    "id": "wf_waiting_acceptance",
    "name": "等待服务人员接单",
    "assigneeRole": "role_care_worker",
    "phase": "调度"
   },
   {
    "id": "wf_scheduled",
    "name": "已排班待服务",
    "assigneeRole": "role_care_worker",
    "phase": "执行"
   },
   {
    "id": "wf_in_service",
    "name": "服务执行中",
    "assigneeRole": "role_care_worker",
    "phase": "执行"
   },
   {
    "id": "wf_result_confirmation",
    "name": "服务结果待确认",
    "assigneeRole": "role_elder_family",
    "phase": "验收"
   },
   {
    "id": "wf_service_completed",
    "name": "服务已完成",
    "assigneeRole": "role_operations_lead",
    "phase": "归档"
   },
   {
    "id": "wf_issue_handling",
    "name": "反馈与风险处理中",
    "assigneeRole": "role_service_coordinator",
    "phase": "异常处理"
   },
   {
    "id": "wf_issue_closed",
    "name": "反馈与风险已闭环",
    "assigneeRole": "role_operations_lead",
    "phase": "归档"
   },
   {
    "id": "wf_request_cancelled",
    "name": "需求已取消",
    "assigneeRole": "role_service_coordinator",
    "phase": "结束"
   }
  ],
  "transitions": [
   {
    "from": "wf_intake",
    "to": "wf_request_processing",
    "condition": "已建立或匹配老人档案并生成带处理状态的服务需求记录"
   },
   {
    "from": "wf_request_processing",
    "to": "wf_dispatching",
    "condition": "服务类型、服务对象、期望时间和服务地址已确认"
   },
   {
    "from": "wf_request_processing",
    "to": "wf_request_cancelled",
    "condition": "需求被老人及家属撤回或确认无法受理"
   },
   {
    "from": "wf_dispatching",
    "to": "wf_waiting_acceptance",
    "condition": "已根据服务时间、地点和能力匹配服务人员并发送任务"
   },
   {
    "from": "wf_waiting_acceptance",
    "to": "wf_scheduled",
    "condition": "服务人员接受任务"
   },
   {
    "from": "wf_waiting_acceptance",
    "to": "wf_dispatching",
    "condition": "服务人员拒绝任务或在规定时间内未接单，需要重新调度"
   },
   {
    "from": "wf_scheduled",
    "to": "wf_in_service",
    "condition": "服务人员到达服务地址并完成签到"
   },
   {
    "from": "wf_in_service",
    "to": "wf_result_confirmation",
    "condition": "服务人员完成服务并记录签退及服务结果"
   },
   {
    "from": "wf_result_confirmation",
    "to": "wf_service_completed",
    "condition": "老人及家属确认服务结果或确认窗口期结束且无异议"
   },
   {
    "from": "wf_result_confirmation",
    "to": "wf_issue_handling",
    "condition": "老人及家属提交投诉、建议或安全问题"
   },
   {
    "from": "wf_service_completed",
    "to": "wf_issue_handling",
    "condition": "后续收到与已完成服务相关的反馈、投诉或安全异常"
   },
   {
    "from": "wf_issue_handling",
    "to": "wf_issue_closed",
    "condition": "已分派责任人并在两个工作日内记录处理结论和跟进结果"
   }
  ]
 },
