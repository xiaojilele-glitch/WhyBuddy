    "systems": [
     "workflow",
     "datamodel"
    ],
    "refs": [
     "service_order",
     "service_order.status",
     "pending_node",
     "progress_node",
     "inspection_node",
     "completed_node",
     "rejected_node"
    ]
   },
   {
    "id": "inv_subsidy_claim_fields",
    "statement": "财务人员访问补贴报销管理时必须呈现单号、老人及金额字段",
    "systems": [
     "datamodel"
    ],
    "refs": [
