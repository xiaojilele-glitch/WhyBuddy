   }
  ],
  "landingPageRef": "p1",
  "preferredDevice": "desktop",
  "roleRefs": [
   "community_admin",
   "care_worker",
   "finance_officer",
   "family_member"
  ],
  "dataModelRefs": [
   "elderly",
   "service_order",
   "subsidy_claim",
   "care_schedule"
  ],
  "appIdentity": {
