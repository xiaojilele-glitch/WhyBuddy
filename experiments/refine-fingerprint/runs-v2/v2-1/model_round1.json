        "tone": "default"
       },
       {
        "id": "in_progress",
        "label": "进行中",
        "tone": "processing"
       },
       {
        "id": "inspection",
        "label": "待验收",
        "tone": "warning"
       },
       {
        "id": "completed",
        "label": "已完成",
        "tone": "success"
       },
       {
        "id": "rejected",
        "label": "已驳回",
        "tone": "danger"
       }
      ]
     },
     {
      "id": "cost",
      "name": "服务费用",
      "type": "number",
      "format": "money"
     },
     {
      "id": "create_date",
      "name": "创建日期",
      "type": "date"
     }
    ]
   },
   {
    "id": "subsidy_claim",
    "name": "补贴报销",
