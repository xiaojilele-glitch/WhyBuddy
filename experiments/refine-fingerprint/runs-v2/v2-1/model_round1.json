     {
      "id": "claim_no",
      "name": "报销单号",
      "type": "string"
     },
     {
      "id": "elderly_ref",
      "name": "关联老人",
      "type": "ref",
      "refEntity": "elderly"
     },
     {
      "id": "amount",
      "name": "报销金额",
      "type": "number",
      "format": "money"
     },
