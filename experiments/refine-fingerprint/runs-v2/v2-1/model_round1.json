     },
     {
      "id": "worker_name",
      "name": "工作人员",
      "type": "string"
     },
     {
      "id": "shift_time",
      "name": "服务时段",
      "type": "string"
     },
     {
      "id": "elderly_ref",
      "name": "服务老人",
      "type": "ref",
      "refEntity": "elderly"
     }
    ]
