     "order:write"
    ]
   },
   {
    "id": "menu_claim",
    "label": "财务报销",
    "roleRefs": [
     "community_admin",
     "finance_officer"
    ],
    "permissionRefs": [
     "claim:read",
     "claim:write"
    ]
   }
  ]
 },
 "workflow": {
  "id": "service_lifecycle",
  "name": "服务工单生命周期",
  "nodes": [
   {
    "id": "pending_node",
    "name": "待派单",
    "assigneeRole": "community_admin",
    "phase": "申请"
   },
   {
    "id": "progress_node",
    "name": "进行中",
    "assigneeRole": "care_worker",
    "phase": "执行"
   },
   {
    "id": "inspection_node",
    "name": "待验收",
    "assigneeRole": "community_admin",
    "phase": "验收"
   },
   {
    "id": "completed_node",
    "name": "已完成",
    "assigneeRole": "community_admin",
    "phase": "归档"
   },
   {
    "id": "rejected_node",
    "name": "已驳回",
    "assigneeRole": "community_admin",
    "phase": "归档"
   }
  ],
  "transitions": [
   {
    "from": "pending_node",
    "to": "progress_node",
    "condition": "已指派护理人员"
   },
   {
    "from": "progress_node",
    "to": "inspection_node",
    "condition": "服务完成提交验收"
   },
   {
    "from": "inspection_node",
    "to": "completed_node",
    "condition": "验收合格"
   },
   {
    "from": "inspection_node",
    "to": "rejected_node",
    "condition": "验收不合格"
   },
   {
    "from": "rejected_node",
    "to": "pending_node",
    "condition": "重新调整派单"
   }
  ],
  "chains": [
   {
    "id": "money_chain",
    "name": "补贴核销流程",
    "kind": "money",
    "nodes": [
     {
      "id": "claim_submit",
      "name": "提交报销",
      "assigneeRole": "community_admin",
      "phase": "申请"
     },
     {
      "id": "claim_audit",
      "name": "财务审核",
      "assigneeRole": "finance_officer",
      "phase": "审核"
     },
     {
      "id": "claim_payout",
      "name": "完成核销",
      "assigneeRole": "finance_officer",
      "phase": "执行"
     }
    ],
    "transitions": [
     {
      "from": "claim_submit",
      "to": "claim_audit"
     },
     {
      "from": "claim_audit",
      "to": "claim_payout",
      "condition": "审核通过"
     }
    ]
   }
  ]
 },
