{
 "datamodel": {
  "entities": [
   {
    "id": "work_order",
    "name": "工单",
    "fields": [
     {
      "id": "order_no",
      "name": "工单编号",
      "type": "string"
     },
     {
      "id": "elderly_name",
      "name": "长者姓名",
      "type": "string"
     },
     {
      "id": "service_type",
      "name": "服务类型",
      "type": "enum"
     },
     {
      "id": "urgency",
      "name": "紧急程度",
      "type": "enum"
     },
     {
      "id": "status",
      "name": "当前状态",
      "type": "enum"
     }
    ]
   },
   {
    "id": "staff",
    "name": "服务人员",
    "fields": [
     {
      "id": "staff_name",
      "name": "服务人员",
      "type": "string"
     }
    ]
   }
  ]
 },
 "rbac": {
  "roles": [
   {
    "id": "role_advisor",
    "name": "社区养老顾问"
   },
   {
    "id": "role_staff",
    "name": "上门服务人员"
   },
   {
    "id": "role_family",
    "name": "家属"
   }
  ],
  "permissions": [
   "work_order:create",
   "work_order:read",
   "work_order:update",
   "work_order:assign",
   "staff:read"
  ],
  "menus": [
   {
    "id": "m1",
    "label": "监控大屏",
    "roleRefs": [
     "role_advisor"
    ],
    "permissionRefs": [
     "work_order:read"
    ]
   },
   {
    "id": "m2",
    "label": "工单管理",
    "roleRefs": [
     "role_staff"
    ],
    "permissionRefs": [
     "work_order:update",
     "work_order:assign"
    ]
   }
  ]
 },
 "workflow": {
  "id": "main_flow",
  "name": "主流程",
  "nodes": [
   {
    "id": "node_created",
    "name": "待派单",
    "assigneeRole": "role_advisor",
    "phase": "创建"
   },
   {
    "id": "node_dispatched",
    "name": "待服务",
    "assigneeRole": "role_staff",
    "phase": "执行"
   },
   {
    "id": "node_finished",
    "name": "已完成",
    "assigneeRole": "role_staff",
    "phase": "结束"
   }
  ],
  "transitions": [
   {
    "from": "node_created",
    "to": "node_dispatched",
    "condition": "完成服务派单"
   },
   {
    "from": "node_dispatched",
    "to": "node_finished",
    "condition": "上门服务完成"
   }
  ]
 },
 "page": {
  "pages": [
   {
    "id": "p1",
    "name": "监控大屏",
    "kind": "monitor",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.status"
    ],
    "actionPermissions": [
     "work_order:read"
    ]
   },
   {
    "id": "p2",
    "name": "工单管理中心",
    "kind": "workbench",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.elderly_name",
     "work_order.service_type",
     "work_order.urgency",
     "work_order.status",
     "staff.staff_name"
    ],
    "actionPermissions": [
     "work_order:read",
     "work_order:update",
     "work_order:assign",
     "staff:read"
    ]
   },
   {
    "id": "p3",
    "name": "移动端服务台",
    "kind": "workbench",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.service_type",
     "work_order.status"
    ],
    "actionPermissions": [
     "work_order:read",
     "work_order:update"
    ]
   },
   {
    "id": "p4",
    "name": "家属端小程序",
    "kind": "workbench",
    "fieldBindings": [
     "work_order.order_no",
     "work_order.elderly_name",
     "work_order.service_type",
     "work_order.status"
    ],
    "actionPermissions": [
     "work_order:create",
     "work_order:read"
    ]
   }
  ]
 },
 "aigc": {
  "capabilities": [
   {
    "id": "ai_summary",
    "name": "工单智能分类",
    "inputFields": [
     "work_order.service_type",
     "work_order.urgency"
    ],
    "outputField": "work_order.status",
    "roleRefs": [
     "role_staff"
    ]
   }
  ]
 },
 "appbundle": {
  "pageBindings": [
   {
    "pageRef": "p2",
    "workflowRef": "main_flow"
   },
   {
    "pageRef": "p3",
    "workflowRef": "node_dispatched"
   }
  ],
  "landingPageRef": "p1",
  "preferredDevice": "desktop",
  "roleRefs": [
   "role_advisor",
   "role_staff",
   "role_family"
  ],
  "dataModelRefs": [
   "work_order",
   "staff"
  ],
  "appIdentity": {
   "appName": "颐安云"
  },
  "invariants": [
   {
    "id": "inv_order_status",
    "statement": "工单在创建后必须经过派单流程并更新状态",
    "systems": [
     "workflow",
     "datamodel"
    ],
    "refs": [
     "work_order",
     "work_order.status",
     "node_created",
     "node_dispatched",
     "role_advisor"
    ]
   }
  ],
  "deviceAuthority": "single-v1"
 }
}