# Copy to .env.preview for the independent preview gateway process.
# pnpm run build:project-preview
# pnpm run dev:project-preview
# Use Node 22+. Keep E2B/LLM/database credentials in the Python host only.

# Reach the real Python /internal/project-preview authority; HTTPS remotely.
WHYBUDDY_PROJECT_PREVIEW_AUTHORITY_URL=http://127.0.0.1:9700/api/sliderule/internal/project-preview
# Must match the Python host's independent gateway key (32+ random characters).
WHYBUDDY_PROJECT_PREVIEW_GATEWAY_KEY=
WHYBUDDY_PROJECT_PREVIEW_PORT=3002
# TLS terminates at the dedicated preview ingress, preserving Host and WS.
WHYBUDDY_PROJECT_PREVIEW_PUBLIC_PROTOCOL=https:
# Exact permitted parent origin for element-to-source selection (no wildcard).
WHYBUDDY_PROJECT_WORKBENCH_ORIGIN=https://workbench.example.com
# http: is accepted only for loopback/*.localhost transport development.
# E2B cannot reach local-only origins; cloud use requires routed HTTPS/WSS.
