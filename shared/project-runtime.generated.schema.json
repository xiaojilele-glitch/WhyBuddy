        "stateVersion": {
          "default": 0,
          "title": "Stateversion",
          "type": "integer"
        },
        "pendingEvent": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pendingevent"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        }
