        "operationId": {
          "title": "Operationid",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "idempotencyKey": {
