          "title": "Status",
          "type": "string"
        },
        "cancelRequested": {
          "title": "Cancelrequested",
          "type": "boolean"
        },
        "lastAccessAt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lastaccessat"
        },
        "stateVersion": {
          "title": "Stateversion",
          "type": "integer"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "projectId",
        "sessionId",
        "kind",
        "expectedRevision",
        "status",
        "cancelRequested",
        "lastAccessAt",
        "stateVersion",
        "createdAt",
        "updatedAt"
      ],
      "title": "ProjectOperationView",
      "type": "object"
