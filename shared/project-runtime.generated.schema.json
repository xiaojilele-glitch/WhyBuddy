          "type": "string"
        },
        "currentRevision": {
          "title": "Currentrevision",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
