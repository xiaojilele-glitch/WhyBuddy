        "lastAccessAt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastaccessat"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInstance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
