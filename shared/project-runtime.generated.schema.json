    "ProjectDeliveryStatus": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
