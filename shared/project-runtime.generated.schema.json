        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "parentBackupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
