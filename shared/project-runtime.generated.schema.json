    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "sizeBytes": {
          "title": "Sizebytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "title": "ManifestFile",
      "type": "object"
    },
    "PreviewDescriptor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project",
          "default": "project",
          "title": "Kind",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "runtimeId": {
          "title": "Runtimeid",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "status": {
          "enum": [
            "provisioning",
            "syncing",
            "installing",
            "executing",
            "starting",
            "ready",
            "stopping",
            "stopped",
            "expired",
            "failed",
            "reconciling"
          ],
          "title": "Status",
          "type": "string"
        },
        "entryUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
