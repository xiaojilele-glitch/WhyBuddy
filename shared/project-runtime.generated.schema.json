          "title": "Parentbackupid"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "sizeBytes": {
          "title": "Sizebytes",
          "type": "integer"
        },
        "sourceRevision": {
          "title": "Sourcerevision",
          "type": "string"
        },
        "dataSchemaVersion": {
          "const": 1,
