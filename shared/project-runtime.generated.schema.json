            "queued",
            "running",
            "waiting_user",
            "completed",
            "failed",
            "cancelling",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
